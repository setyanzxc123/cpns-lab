# =============================================================================
# CPNS Lab — Environment Variables Example
# Salin file ini menjadi `.env.local` lalu isi nilainya:
#   copy .env.example .env.local
# =============================================================================

# [Wajib jika ingin menggunakan fitur AI]
# Dapatkan Gemini API Key dari Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# [Flag UI untuk menampilkan status AI aktif di aplikasi]
# Set ke 1 jika GEMINI_API_KEY sudah diisi
NEXT_PUBLIC_HAS_GEMINI=1

# [Opsional: Jika ingin sinkronisasi multi-perangkat via Supabase]
# Jika dikosongkan, aplikasi akan otomatis beroperasi 100% secara lokal (localStorage)
# Dapatkan URL & Anon Key dari Project Settings -> API di dashboard Supabase: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# [HANYA LOKAL — jangan pernah dipasang di Vercel/browser]
# Dipakai skrip seed bank soal: node --env-file=.env.local scripts/seed-questions.mjs
# Proyek Supabase baru: pakai Secret key (sb_secret_...) dari Project Settings -> API Keys
# (setara service_role legacy). Server-only: bypass RLS — jangan pernah di-commit.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here
