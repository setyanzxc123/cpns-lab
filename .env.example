# =============================================================================
# CPNS Lab — Environment Variables Example
# Salin file ini menjadi `.env.local` lalu isi nilainya:
#   copy .env.example .env.local
# =============================================================================

# [Wajib jika ingin menggunakan fitur AI]
# Dapatkan Gemini API Key dari Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# [Opsional: Pilih model Gemini — dipakai semua route AI, via Interactions API]
# Default: gemini-3.8-flash. API key baru Google hanya menerima keluarga gemini-3.x.
# Contoh lain: gemini-3.8-flash-lite, gemini-flash-latest (alias model terbaru).
GEMINI_MODEL=gemini-3.8-flash

# [Opsional: Knob thinking level — dipakai semua route AI]
#   off      = matikan thinking (paling cepat & murah)
#   minimal | low | medium | high = tingkat effort thinking model
# Default (tidak diset): ikut default model.
# CATATAN: token thinking dihitung ke dalam maxOutputTokens per route
# (chat 2048, explain 600, analyze 1200) — level tinggi berisiko memotong jawaban.
# GEMINI_THINKING_LEVEL=low

# [Flag UI untuk menampilkan status AI aktif di aplikasi]
# Set ke 1 jika GEMINI_API_KEY sudah diisi
NEXT_PUBLIC_HAS_GEMINI=1

# [Opsional: Jika ingin sinkronisasi multi-perangkat via Supabase]
# Jika dikosongkan, aplikasi akan otomatis beroperasi 100% secara lokal (localStorage)
# Dapatkan URL & Anon Key dari Project Settings -> API di dashboard Supabase: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# [HANYA LOKAL — jangan pernah dipasang di Vercel/browser]
# Dipakai skrip seed bank soal: node --env-file=.env.local scripts/seed-questions.mjs
# Proyek Supabase baru: pakai Secret key (sb_secret_...) dari Project Settings -> API Keys
# (setara service_role legacy). Server-only: bypass RLS — jangan pernah di-commit.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key_here

# [Opsional: Login dengan akun Google]
# Set ke 1 untuk menampilkan tombol "Lanjut dengan Google" di dialog Masuk.
# Kredensial OAuth-nya TIDAK di env app — pasang di dashboard Supabase:
#   1. Authentication -> Providers -> Google -> aktifkan.
#   2. Isi Client ID [data.oauth_client_id] & Client Secret dari Google Cloud
#      Console (APIs & Services -> Credentials -> OAuth client ID, tipe Web).
#   3. Authorized redirect URI di Google Cloud Console:
#      https://<project-ref>.supabase.co/auth/v1/callback
#   4. Supabase Authentication -> URL Configuration: tambahkan URL produksi
#      (mis. https://app-anda.vercel.app) ke Redirect URLs.
NEXT_PUBLIC_HAS_GOOGLE=0
